{
  "name": "diff",
  "type": "module",
  "private": true,
  "license": "Unlicense",
  "bin": {
    "diff": "bin/diff.ts"
  },
  "scripts": {
    "server": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "perf": "bun checks/perf.ts && bun checks/perf.ts --fixture deletions",
    "check": "tsc --noEmit && bun test && bun checks/bundle.ts && bun run perf",
    "ratchet": "bun checks/bundle.ts --ratchet && bun checks/perf.ts --ratchet && bun checks/perf.ts --fixture deletions --ratchet"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright-core": "1.64.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@pierre/diffs": "^1.5.2",
    "shiki": "4.5.0"
  }
}
